# ---------------------------------------------------------------------------
#  Нужно ТОЛЬКО для docker-режима (docker compose up).
#  При обычном запуске (start.bat / python run.py / install_linux.sh) этот
#  файл не используется — настройки хранятся в config/app.json.
#
#  Скопируйте в .env и задайте хотя бы пароль администратора PostgreSQL.
# ---------------------------------------------------------------------------

# Пароль суперпользователя postgres в контейнере TimescaleDB. Приложение
# создаст под ним свою базу, роль для записи и роль только на чтение.
POSTGRES_ADMIN_PASSWORD=change_me_please

# Имя базы приложения
PLC_DB_NAME=plc

# Порты на хосте
PLC_WEB_PORT=8000
GRAFANA_HOST_PORT=3000
# PostgreSQL виден только с самой машины (127.0.0.1)
POSTGRES_HOST_PORT=5433

# Вход в Grafana для правки дашбордов (просмотр открыт без входа)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Если Grafana открывают не по адресу машины, а через обратный прокси,
# укажите её адрес для браузера, например https://grafana.plant.local
PLC_GRAFANA_PUBLIC_URL=
