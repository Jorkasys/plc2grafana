# ---------------------------------------------------------------------------
#  Нужно ТОЛЬКО для docker-режима (docker compose up).
#  При локальном запуске (python run.py) все настройки задаются в браузере
#  и хранятся в config/app.json — этот файл не используется.
#
#  Скопируйте в .env и подставьте свои значения.
# ---------------------------------------------------------------------------

# --- PostgreSQL / TimescaleDB ---
# Учётка администратора: приложение под ней создаст базу, роли и схему
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change_me_please
# Имя базы, которую создаст приложение
PLC_DB_NAME=plc
# Порт, на котором БД видна с хоста (внутри compose всегда 5432)
POSTGRES_HOST_PORT=5432

# --- Веб-интерфейс ---
PLC_WEB_PORT=8000

# --- Grafana (профиль grafana) ---
GRAFANA_HOST_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
PLC_GRAFANA_URL=http://localhost:3000
